-- AUTOMATIC BASE DISCOVERY

local BaseFolderNames = {
    "Bases",
    "Base",
    "Plots",
    "PlayerBases",
    "Tycoons",
    "PlayerPlots",
    "Land"
}

local PetFolderNames = {
    "Brainrots",
    "Pets",
    "Units",
    "Characters"
}

local function findNamedChild(parent, names)
    for _, name in ipairs(names) do
        local object = parent:FindFirstChild(name)

        if object then
            return object
        end
    end

    return nil
end

local function findBaseFolder()
    -- Search direct workspace children first

    local folder = findNamedChild(
        workspace,
        BaseFolderNames
    )

    if folder then
        return folder
    end

    -- Search nested containers

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Folder") or obj:IsA("Model") then

            for _, name in ipairs(BaseFolderNames) do
                if obj.Name:lower() == name:lower() then
                    return obj
                end
            end

        end
    end

    return nil
end

-- PET DETECTION

local function getPetContainer(base)
    return findNamedChild(base, PetFolderNames)
end

local function getPetPart(pet)
    if pet:IsA("BasePart") then
        return pet
    end

    if pet:IsA("Model") then
        return pet.PrimaryPart
            or pet:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end

    return nil
end

local function getPetValue(pet)
    local attributes = {
        "Value",
        "Income",
        "MoneyPerSecond",
        "Price",
        "Worth"
    }

    for _, attribute in ipairs(attributes) do
        local value = pet:GetAttribute(attribute)

        if typeof(value) == "number" then
            return value, true
        end
    end

    local rarity = pet:GetAttribute("Rarity")

    return Rarity[rarity] or 0, false
end

-- BEST PET SEARCH

local function findBestPet()
    local bases = findBaseFolder()

    if not bases then
        return nil, nil, "Base folder not found"
    end

    local bestBase = nil
    local bestPet = nil

    local bestValue = -math.huge
    local bestHasMoney = false

    for _, base in ipairs(bases:GetChildren()) do

        if not base:IsA("Model")
            and not base:IsA("Folder") then
            continue
        end

        local owner = base:GetAttribute("OwnerUserId")

        if owner == player.UserId then
            continue
        end

        local petFolder = getPetContainer(base)

        if not petFolder then
            continue
        end

        for _, pet in ipairs(petFolder:GetChildren()) do

            if not pet:IsA("Model")
                and not pet:IsA("BasePart") then
                continue
            end

            if not getPetPart(pet) then
                continue
            end

            local value, hasMoney = getPetValue(pet)

            local better = false

            if hasMoney and not bestHasMoney then
                better = true

            elseif hasMoney == bestHasMoney
                and value > bestValue then
                better = true
            end

            if better then
                bestValue = value
                bestHasMoney = hasMoney

                bestPet = pet
                bestBase = base
            end

        end
    end

    if not bestPet then
        return nil, nil, "No compatible pets found"
    end

    return bestBase, bestPet
end

-- ENTRANCE DISCOVERY

local function findEntrance(base)
    local names = {
        "Entrance",
        "Gate",
        "Door",
        "Spawn",
        "BaseSpawn"
    }

    for _, name in ipairs(names) do
        local part = base:FindFirstChild(name, true)

        if part and part:IsA("BasePart") then
            return part
        end
    end

    return nil
end

-- TELEPORT

local function teleportToBase(base)
    local character = getCharacter()

    local entrance = findEntrance(base)

    if not entrance then
        return false, "Entrance not found"
    end

    local target =
        entrance.CFrame * CFrame.new(
            0,
            3,
            -Settings.EntranceDistance
        )

    character:PivotTo(target)

    return true
end

-- GEAR SYSTEM

local function findTool(slot, keywords)
    local character = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")

    local containers = {
        backpack,
        character
    }

    -- Try explicit hotbar attributes

    for _, container in ipairs(containers) do
        if not container then
            continue
        end

        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then

                if tool:GetAttribute("HotbarSlot") == slot then
                    return tool
                end

            end
        end
    end

    -- Fallback: match tool names

    for _, container in ipairs(containers) do
        if not container then
            continue
        end

        for _, tool in ipairs(container:GetChildren()) do
            if not tool:IsA("Tool") then
                continue
            end

            local name = tool.Name:lower()

            for _, keyword in ipairs(keywords) do
                if name:find(keyword, 1, true) then
                    return tool
                end
            end
        end
    end

    return nil
end

local function equipTool(slot, names)
    local _, humanoid = getCharacter()

    local tool = findTool(slot, names)

    if not tool then
        return nil
    end

    humanoid:EquipTool(tool)

    return tool
end

-- BROOM

local function equipBroom()
    return equipTool(
        Settings.BroomSlot,
        {
            "broom",
            "besen",
            "flying broom"
        }
    )
end

-- CLONER

local function activateCloner()
    local cloner = equipTool(
        Settings.ClonerSlot,
        {
            "cloner",
            "clone",
            "body clone"
        }
    )

    if not cloner then
        return false
    end

    task.wait(0.1)

    cloner:Activate()

    return true
end

-- FLIGHT SYSTEM

local function flyToPet(pet)
    local _, humanoid, root = getCharacter()

    local part = getPetPart(pet)

    if not part then
        return false
    end

    local destination =
        part.CFrame * CFrame.new(
            0,
            Settings.PetHeight,
            0
        )

    local distance =
        (root.Position - destination.Position).Magnitude

    local duration = math.max(
        0.1,
        distance / Settings.FlySpeed
    )

    local oldAnchored = root.Anchored
    local oldRotate = humanoid.AutoRotate

    root.Anchored = true
    humanoid.AutoRotate = false

    local tween = TweenService:Create(
        root,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear
        ),
        {
            CFrame = destination
        }
    )

    tween:Play()

    local playbackState = tween.Completed:Wait()

    root.Anchored = oldAnchored
    humanoid.AutoRotate = oldRotate

    return playbackState ==
        Enum.PlaybackState.Completed
end

-- MAIN ROUTE

local function startRoute()
    if Settings.Running then
        return
    end

    Settings.Running = true
    start.Text = "RUNNING..."

    local success, errorMessage = pcall(function()

        -- STEP 1: FIND PET

        updateStatus("Scanning bases...")

        local base, pet, reason = findBestPet()

        if not base or not pet then
            error(reason or "Target not found")
        end

        updateStatus("Best pet: " .. pet.Name)

        -- STEP 2: TELEPORT

        updateStatus("Teleporting to target base...")

        local teleported, teleportError =
            teleportToBase(base)

        if not teleported then
            error(teleportError)
        end

        task.wait(0.2)

        -- STEP 3: BROOM

        if Settings.AutoEquip then
            updateStatus("Equipping broom (Slot 3)...")

            local broom = equipBroom()

            if not broom then
                error("Broom not found")
            end

            task.wait(0.15)
        end

        -- STEP 4: CLONER

        if Settings.AutoClone then
            updateStatus("Activating cloner (Slot 6)...")

            local activated = activateCloner()

            if not activated then
                error("Cloner not found")
            end

            task.wait(0.3)
        end

        -- STEP 5: BROOM AGAIN

        if Settings.AutoFly then
            updateStatus("Preparing flight...")

            local broom = equipBroom()

            if not broom then
                error("Broom unavailable")
            end

            task.wait(0.1)

            -- STEP 6: FLY TO PET

            updateStatus("Flying to " .. pet.Name)

            local arrived = flyToPet(pet)

            if not arrived then
                error("Flight interrupted")
            end
        end

        updateStatus("Route completed: " .. pet.Name)
    end)

    if not success then
        updateStatus("Error: " .. tostring(errorMessage))
        warn("[XENHUB V5]", errorMessage)
    end

    Settings.Running = false
    start.Text = "START AUTO ROUTE"
end

